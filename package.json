{
  "name": "linkedin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalny serwer MCP do planowania postów na LinkedIn (profil osobisty)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node dist/cli/index.js",
    "doctor": "node dist/cli/index.js doctor",
    "pause": "node dist/cli/index.js pause",
    "resume": "node dist/cli/index.js resume",
    "worker": "node dist/worker/index.js",
    "mcp:stdio": "node dist/mcp-stdio/index.js",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/mcp-stdio/index.js",
    "status": "node dist/cli/index.js status",
    "worker:start": "node dist/cli/index.js worker start",
    "worker:stop": "node dist/cli/index.js worker stop",
    "worker:restart": "node dist/cli/index.js worker restart",
    "worker:status": "node dist/cli/index.js worker status",
    "worker:logs": "node dist/cli/index.js worker logs",
    "autostart:install": "node dist/cli/index.js autostart install",
    "autostart:uninstall": "node dist/cli/index.js autostart uninstall",
    "claude-config": "node dist/cli/index.js claude-config",
    "setup": "npm install && npm run build",
    "login": "node dist/cli/index.js login",
    "token:status": "node dist/cli/index.js token status",
    "token:import": "node dist/cli/index.js token import",
    "server-http": "node dist/server-http/index.js",
    "server:status": "node dist/cli/index.js server status",
    "server:pause": "node dist/cli/index.js server pause",
    "server:resume": "node dist/cli/index.js server resume"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "bree": "^9.2.9",
    "dotenv": "^18.0.4",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
