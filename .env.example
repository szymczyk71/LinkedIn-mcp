# Skopiuj do .env (w katalogu repozytorium) i uzupełnij. Plik .env jest w .gitignore.

# Tryb klienta LinkedIn: mock (atrapa, domyślnie) albo live (prawdziwe API).
# Tryb live trzeba ustawić jawnie; worker pokaże wtedy baner przy starcie.
LINKEDIN_MODE=mock

# Katalog danych (baza, audyt, flaga PAUSE, zaszyfrowane tokeny).
# Puste = %LOCALAPPDATA%\linkedin-mcp. Musi być poza repozytorium.
LINKEDIN_MCP_DATA_DIR=

# Lokalne API workera (zawsze 127.0.0.1).
WORKER_PORT=47811

# Harmonogram i walidacje
DEFAULT_TIMEZONE=Europe/Warsaw
MIN_LEAD_MIN=5
MISSED_GRACE_MIN=60
PLAN_TTL_MIN=30
POST_MAX_CHARS=3000
COMMENT_DELAY_DEFAULT_MIN=10
# Maksymalny rozmiar obrazu w poście (MB). Formaty: JPG, PNG, GIF.
IMAGE_MAX_MB=10
# Co ile minut działa harmonogram (dzielnik 60). Post wychodzi przy pierwszym przebiegu >= terminu.
SCHEDULER_INTERVAL_MIN=5

# Aplikacja LinkedIn (Developer Portal) z produktem Community Management API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Domyślnie http://127.0.0.1:47811/oauth/callback (lokalnie) albo <PUBLIC_BASE_URL>/oauth/callback (serwer)
LINKEDIN_REDIRECT_URI=
# Wersja API LinkedIn (nagłówek Linkedin-Version, RRRRMM). Każda wersja działa min. rok.
LINKEDIN_API_VERSION=202609
# Numer strony firmy, w imieniu której publikujemy (z adresu linkedin.com/company/<numer>/admin)
LINKEDIN_ORGANIZATION_ID=
# Nazwa strony do wyświetlania w statusie (opcjonalnie)
LINKEDIN_ORGANIZATION_NAME=KTBnet
# Role na stronie firmy, które mogą korzystać z planera
LINKEDIN_ALLOWED_ROLES=ADMINISTRATOR,CONTENT_ADMINISTRATOR
# Zakresy OAuth (domyślnie: r_organization_admin w_organization_social).
# Jeśli w Developer Portal (zakładka Auth) są też r_basicprofile i w_organization_social_feed - dopisz je.
LINKEDIN_SCOPES=

# Klucz szyfrowania tokenów (32 bajty base64). Puste = klucz w Menedżerze poświadczeń Windows.
LINKEDIN_MCP_ENC_KEY=

# ---- Wariant server-http (Azure) - lokalnie niepotrzebne ----
# Publiczny adres HTTPS aplikacji (bez ścieżki). Konektor w Claude: <PUBLIC_BASE_URL>/mcp
PUBLIC_BASE_URL=
# PostgreSQL, np. postgres://user:haslo@host:5432/linkedin_mcp?sslmode=require
DATABASE_URL=
# Adres i port nasłuchu (w kontenerze HTTP_HOST=0.0.0.0)
HTTP_HOST=
HTTP_PORT=8080
# Ważność tokenu dostępu konektora (min) i limit zapytań na minutę z jednego adresu
MCP_ACCESS_TOKEN_TTL_MIN=60
RATE_LIMIT_PER_MIN=120
